# ============================================================
# 号码工作台 .gitignore
# 原则：仓库只含源码、配置、文档、测试、工具。
#       库文件、产物、缓存、日志、过程留证一律不入仓库。
# ============================================================

# ---- 库文件（数据隐私，绝不入库）----
valid_customers.txt
opened_customers.txt
invalid_customers.txt
*_customers.txt

# ---- 构建产物 ----
dist/
build/
library-auto.zip

# ---- 缓存 ----
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# ---- 过程与运行数据 ----
artifacts/
*.log
settings.ini
.workbuddy-ai/

# ---- 运行/校验产物（已定：不进仓库）----
benchmark-results.json
exe-validation.json
